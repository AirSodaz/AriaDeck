{
  "manifest_version": 3,
  "name": "AriaDeck",
  "version": "0.1.0",
  "description": "Send a download to AriaDeck, with the headers the site needs.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "contextMenus", "nativeMessaging", "storage"],
  "optional_permissions": ["cookies"],
  "optional_host_permissions": ["*://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AriaDeck",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
