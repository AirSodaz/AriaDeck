<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?ifndef AppVersion ?>
    <?define AppVersion = "0.2.2" ?>
  <?endif ?>
  <?ifndef Platform ?>
    <?define Platform = "x64" ?>
  <?endif ?>
  <?ifndef SourceDir ?>
    <?define SourceDir = "..\..\dist\AriaDeck_$(var.AppVersion)_windows-$(var.Platform)-portable" ?>
  <?endif ?>

  <?if $(var.Platform) = "arm64" ?>
    <?define Win64 = "yes" ?>
  <?elseif $(var.Platform) = "x64" ?>
    <?define Win64 = "yes" ?>
  <?else ?>
    <?define Win64 = "no" ?>
  <?endif ?>

  <Product Id="*"
           Name="AriaDeck"
           Language="1033"
           Version="$(var.AppVersion)"
           Manufacturer="AriaDeck contributors"
           UpgradeCode="A7B3C5D1-8E2F-4A6B-9C0D-1E2F3A4B5C6D">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perUser"
             Platform="$(var.Platform)"
             Description="AriaDeck Installer" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="AriaDeck" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="AriaDeck" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="*" Win64="$(var.Win64)">
        <File Id="AriaDeckExe" Source="$(var.SourceDir)\ariadeck-desktop.exe" KeyPath="yes" />
      </Component>
      <Component Id="BridgeExecutable" Guid="*" Win64="$(var.Win64)">
        <File Id="AriaDeckBridgeExe" Source="$(var.SourceDir)\ariadeck-bridge.exe" KeyPath="yes" />
      </Component>
      <Component Id="LicenseFile" Guid="*" Win64="$(var.Win64)">
        <File Id="LicenseTxt" Source="$(var.SourceDir)\LICENSE" KeyPath="yes" />
      </Component>
      <Component Id="NoticesFile" Guid="*" Win64="$(var.Win64)">
        <File Id="NoticesTxt" Source="$(var.SourceDir)\THIRD_PARTY_NOTICES.md" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="*" Win64="$(var.Win64)">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="AriaDeck"
                  Description="Native desktop client for aria2"
                  Target="[INSTALLFOLDER]ariadeck-desktop.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="CleanUpShortCut" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\AriaDeck" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*" Win64="$(var.Win64)">
        <Shortcut Id="ApplicationDesktopShortcut"
                  Name="AriaDeck"
                  Description="Native desktop client for aria2"
                  Target="[INSTALLFOLDER]ariadeck-desktop.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\AriaDeck" Name="desktop_shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Complete" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="BridgeExecutable" />
      <ComponentRef Id="LicenseFile" />
      <ComponentRef Id="NoticesFile" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Product>
</Wix>
